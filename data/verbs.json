{
 "version": 3,
 "note": "動詞の3つの形（原形→過去形→過去分詞）。q は 現在・過去・完了 の 3 問（j=英語の語順の日本語・en=答え）。会話用＝音で覚える。kana はおおよその読み。say は読み上げ用（綴りが同じで音が変わるもの）。",
 "steps": [
  {
   "no": 1,
   "name": "超基本 1",
   "sub": "毎日の会話で必ず出る 15 個"
  },
  {
   "no": 2,
   "name": "超基本 2",
   "sub": "食べる・買う・会う。暮らしの 15 個"
  },
  {
   "no": 3,
   "name": "基本 1",
   "sub": "catch・bring・teach など、仕事でも使う 15 個"
  },
  {
   "no": 4,
   "name": "基本 2",
   "sub": "話が広がる 15 個"
  },
  {
   "no": 5,
   "name": "応用 1",
   "sub": "形が変わらない仲間と、3 つ目が「ン」の仲間"
  },
  {
   "no": 6,
   "name": "応用 2",
   "sub": "ここまで言えたら会話で困らない 15 個"
  }
 ],
 "patterns": {
  "aaa": {
   "name": "3 つとも同じ",
   "tip": "形が変わらない。短くて t で終わるものが多い"
  },
  "ought": {
   "name": "オート組",
   "tip": "2 つ目と 3 つ目が「〜オート」。綴りは ought / aught でも音は同じ"
  },
  "aba": {
   "name": "元に戻る組",
   "tip": "3 つ目が原形に戻る"
  },
  "iau": {
   "name": "イ→ェア→ア組",
   "tip": "真ん中の音だけが i → a → u と変わる。2 つ目は口を横に開く「ェア」"
  },
  "en": {
   "name": "3 つ目が「ン」組",
   "tip": "3 つ目が n の音で終わる"
  },
  "short": {
   "name": "イー→エ組",
   "tip": "のばす「イー」が短い「エ」になる。2 つ目と 3 つ目は同じ"
  },
  "dt": {
   "name": "d→t 組",
   "tip": "最後の d が t になるだけ。2 つ目と 3 つ目は同じ"
  },
  "abb": {
   "name": "2 つ目＝3 つ目",
   "tip": "2 つ目と 3 つ目が同じ"
  }
 },
